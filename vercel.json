{
    "buildCommand": null,
    "outputDirectory": "web",
    "framework": null,
    "cleanUrls": true,
    "regions": [
        "sin1"
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                },
                {
                    "key": "Cross-Origin-Embedder-Policy",
                    "value": "require-corp"
                }
            ]
        }
    ]
}
